{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skillspring.dev/schemas/signed-policy-artifact.draft.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm",
    "kind",
    "key_id",
    "organization",
    "artifact_id",
    "revision",
    "issued_at",
    "expires_at",
    "payload",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "skillspring.signed-policy-artifact.draft.v1"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "kind": {
      "enum": [
        "snapshot",
        "review"
      ]
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "organization": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "payload": {
      "type": "object"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  }
}
