{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skillspring.dev/schemas/draft-policy-subject.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate",
    "accessMode",
    "domain",
    "resource",
    "audience",
    "requester",
    "producer",
    "policyVersion",
    "organization",
    "purpose",
    "environment",
    "policy_digest"
  ],
  "properties": {
    "candidate": {
      "type": "object"
    },
    "accessMode": {
      "enum": [
        "DEFAULT",
        "GOVERNANCE",
        "ARCHITECT"
      ]
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "resource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "requester": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "organization": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
