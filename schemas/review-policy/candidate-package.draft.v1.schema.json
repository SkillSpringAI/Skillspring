{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skillspring.dev/schemas/candidate-package.draft.v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "requirements", "candidate", "context_sha256", "sources", "claims"],
  "properties": {
    "schema_version": { "const": "skillspring.candidate-review-package.draft.v1" },
    "requirements": { "const": "sourced-informational-review-v1" },
    "candidate": { "$ref": "https://skillspring.dev/schemas/generated-answer-candidate.v1.json" },
    "context_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "content_sha256", "resource", "organization", "domain", "origin", "captured_at", "text"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "content_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "resource": { "type": "string", "minLength": 1, "maxLength": 256 },
          "organization": { "type": "string", "minLength": 1, "maxLength": 256 },
          "domain": { "type": "string", "minLength": 1, "maxLength": 256 },
          "origin": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "captured_at": { "type": "string", "format": "date-time" },
          "text": { "type": "string", "minLength": 1, "maxLength": 32768, "pattern": "\\S" }
        }
      }
    },
    "claims": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "start", "end", "support"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "start": { "type": "integer", "minimum": 0, "maximum": 16384 },
          "end": { "type": "integer", "minimum": 1, "maximum": 16384 },
          "support": {
            "type": "array", "minItems": 1, "maxItems": 16,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["source_id", "start", "end"],
              "properties": {
                "source_id": { "type": "string", "minLength": 1, "maxLength": 256 },
                "start": { "type": "integer", "minimum": 0, "maximum": 32768 },
                "end": { "type": "integer", "minimum": 1, "maximum": 32768 }
              }
            }
          }
        }
      }
    }
  }
}
