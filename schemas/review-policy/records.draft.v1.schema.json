{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skillspring.dev/schemas/draft-policy-records.v1.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "reviewer",
      "role",
      "subjectHash",
      "decision",
      "evidence",
      "authorityClaims",
      "outputChecks",
      "reviewedAt",
      "expiresAt",
      "revoked"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "reviewer": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "role": {
        "enum": [
          "user",
          "domain_reviewer",
          "governance_officer",
          "engineering_maintainer",
          "access_administrator"
        ]
      },
      "subjectHash": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "decision": {
        "enum": [
          "APPROVE",
          "REJECT"
        ]
      },
      "evidence": {
        "enum": [
          "VERIFIED",
          "UNVERIFIED"
        ]
      },
      "authorityClaims": {
        "enum": [
          "CLEARED",
          "PENDING"
        ]
      },
      "outputChecks": {
        "enum": [
          "PASS",
          "FAIL"
        ]
      },
      "reviewedAt": {
        "type": "integer",
        "minimum": 0
      },
      "expiresAt": {
        "type": "integer",
        "minimum": 0
      },
      "revoked": {
        "type": "boolean"
      }
    }
  },
  "maxItems": 256
}
