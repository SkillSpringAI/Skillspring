{
  "$id": "skillspring.authority.dla.v1",
  "type": "object",
  "required": [
    "id",
    "trace_id",
    "mode",
    "mode_reason",
    "policy_snapshot",
    "timestamp",
    "integrity_hash"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 8 },
    "trace_id": { "type": "string", "minLength": 8 },
    "parent_dla": { "type": ["string", "null"], "minLength": 8 },
    "mode": { "enum": ["DEFAULT", "GOVERNANCE", "ARCHITECT"] },
    "mode_reason": {
      "enum": ["ARCHITECT_KEYWORDS", "RECONSTRUCTION_RISK", "DUAL_USE", "RIGHTS_IMPACT", "DEFAULT_SAFE"]
    },
    "policy_snapshot": {
      "type": "object",
      "required": ["decision", "decision_code", "mode_reason"],
      "properties": {
        "decision": { "enum": ["ALLOW", "REFUSE"] },
        "decision_code": { "type": "string", "minLength": 1 },
        "mode_reason": {
          "enum": ["ARCHITECT_KEYWORDS", "RECONSTRUCTION_RISK", "DUAL_USE", "RIGHTS_IMPACT", "DEFAULT_SAFE"]
        }
      },
      "additionalProperties": false
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "integrity_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
