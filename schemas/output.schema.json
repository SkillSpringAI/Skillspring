{
  "$id": "skillspring.output.v1",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "mode", "mode_reason", "trace_id", "policy", "evidence", "response"],
      "properties": {
        "ok": { "const": true },
        "mode": { "enum": ["DEFAULT", "GOVERNANCE", "ARCHITECT"] },
        "mode_reason": {
          "enum": ["ARCHITECT_KEYWORDS", "RECONSTRUCTION_RISK", "DUAL_USE", "RIGHTS_IMPACT", "DEFAULT_SAFE"]
        },
        "trace_id": { "type": "string", "minLength": 8 },

        "policy": {
          "type": "object",
          "required": ["decision", "decision_code", "mode_reason", "dataset_versions", "trigger_hits", "evidence_status"],
          "properties": {
            "decision": { "const": "ALLOW" },
            "decision_code": { "type": "string", "minLength": 1 },
            "mode_reason": {
              "enum": ["ARCHITECT_KEYWORDS", "RECONSTRUCTION_RISK", "DUAL_USE", "RIGHTS_IMPACT", "DEFAULT_SAFE"]
            },
            "dataset_versions": {
              "type": "object",
              "required": ["dual_use", "reconstruction"],
              "properties": {
                "dual_use": { "type": "string", "minLength": 1 },
                "reconstruction": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            },
            "trigger_hits": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["dataset", "id"],
                "properties": {
                  "dataset": { "type": "string", "minLength": 1 },
                  "id": { "type": "string", "minLength": 1 },
                  "match": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "evidence_status": { "enum": ["KNOWN", "UNKNOWN"] }
          },
          "additionalProperties": false
        },

        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["item", "status"],
            "properties": {
              "item": { "type": "string" },
              "status": { "enum": ["PROVIDED", "ASSUMED", "UNKNOWN", "ESTIMATE"] }
            },
            "additionalProperties": false
          }
        },

        "response": {
          "type": "object",
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "SAFE_STUB" },
            "text": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    {
      "type": "object",
      "required": ["ok", "mode", "mode_reason", "trace_id", "policy", "refusal"],
      "properties": {
        "ok": { "const": false },
        "mode": { "enum": ["DEFAULT", "GOVERNANCE", "ARCHITECT"] },
        "mode_reason": {
          "enum": ["ARCHITECT_KEYWORDS", "RECONSTRUCTION_RISK", "DUAL_USE", "RIGHTS_IMPACT", "DEFAULT_SAFE"]
        },
        "trace_id": { "type": "string", "minLength": 8 },

        "policy": {
          "type": "object",
          "required": ["decision", "decision_code", "mode_reason", "dataset_versions", "trigger_hits", "evidence_status"],
          "properties": {
            "decision": { "const": "REFUSE" },
            "decision_code": { "type": "string", "minLength": 1 },
            "mode_reason": {
              "enum": ["ARCHITECT_KEYWORDS", "RECONSTRUCTION_RISK", "DUAL_USE", "RIGHTS_IMPACT", "DEFAULT_SAFE"]
            },
            "dataset_versions": {
              "type": "object",
              "required": ["dual_use", "reconstruction"],
              "properties": {
                "dual_use": { "type": "string", "minLength": 1 },
                "reconstruction": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            },
            "trigger_hits": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["dataset", "id"],
                "properties": {
                  "dataset": { "type": "string", "minLength": 1 },
                  "id": { "type": "string", "minLength": 1 },
                  "match": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "evidence_status": { "enum": ["KNOWN", "UNKNOWN"] }
          },
          "additionalProperties": false
        },

        "refusal": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
