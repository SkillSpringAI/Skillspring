{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skillspring://schemas/registries/failure-codes.schema.json",
  "title": "Failure Code Registry v1",
  "type": "object",
  "required": ["version", "codes"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^v1$" },
    "codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "layer", "class", "summary", "retry_scope"],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "description": "Canonical ID in the form LAYER-CLASS-ID",
            "pattern": "^[A-Z]{2,8}-(H|S|A)-[0-9]{3}$"
          },
          "layer": {
            "type": "string",
            "description": "Where this failure is owned/raised",
            "enum": ["CP", "MN", "NM", "LK", "LG", "OP", "DIAG"]
          },
          "class": {
            "type": "string",
            "description": "Severity class; H=halt, S=scoped retry, A=artifact rebuild only",
            "enum": ["H", "S", "A"]
          },
          "summary": { "type": "string", "minLength": 3, "maxLength": 220 },
          "retry_scope": {
            "type": "string",
            "description": "What is legally allowed to change on retry",
            "enum": ["none", "scoped_retry", "artifact_rebuild"]
          },
          "notes": { "type": "string", "maxLength": 600 }
        }
      }
    }
  }
}
