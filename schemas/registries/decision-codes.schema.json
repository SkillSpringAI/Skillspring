{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skillspring://schemas/registries/decision-codes.schema.json",
  "title": "SkillSpring Decision and Refusal Codes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "change_control", "codes", "refusal_codes"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "status": { "const": "canonical" },
    "change_control": { "type": "string", "minLength": 1 },
    "codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "class"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "class": { "type": "string", "minLength": 1 }
        }
      }
    },
    "refusal_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^REFUSE-[A-Z0-9-]+$" }
    }
  }
}
