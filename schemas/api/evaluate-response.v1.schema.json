{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skillspring.dev/schemas/evaluate-response.v1.json",
  "title": "SkillSpring v1 evaluation response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "const": "skillspring.evaluate.response.v1" },
    "result": { "$ref": "https://skillspring.dev/schemas/output.schema.json" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "enum": ["INVALID_REQUEST", "EVALUATION_FAILED"] },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  },
  "oneOf": [
    { "properties": { "result": {} }, "required": ["result"] },
    { "properties": { "error": {} }, "required": ["error"] }
  ]
}
