{
    "name":  "skillspring",
    "version":  "1.0.0",
    "description":  "SkillSpring governance-first AI architecture",
    "type":  "module",
    "scripts":  {
                    "preflight":  "npm run build \u0026\u0026 npm run diag",
                    "dev":  "tsx src/cli.ts",
                    "diag":  "tsx diagnostics/run.ts",
                    "build":  "tsc -p tsconfig.json",
                    "run":  "node --enable-source-maps dist/cli.js",
                    "setup-hooks":  "powershell -NoProfile -ExecutionPolicy Bypass -File tools/setup-hooks.ps1",
                    "prepare":  "npm run -s setup-hooks"
                },
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/SkillSpringAI/Skillspring.git"
                   },
    "license":  "ISC",
    "dependencies":  {
                         "ajv":  "^8.17.1",
                         "ajv-formats":  "^3.0.1"
                     },
    "devDependencies":  {
                            "@types/node":  "^25.0.6",
                            "tsx":  "^4.21.0",
                            "typescript":  "^5.9.3"
                        }
}
