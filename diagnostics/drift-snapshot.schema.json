{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillSpring Drift Snapshot",
  "type": "object",
  "required": ["version", "generated_utc", "cases"],
  "properties": {
    "version": { "type": "string" },
    "generated_utc": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "input", "expected", "fingerprint"],
        "properties": {
          "id": { "type": "string" },
          "input": { "type": "string" },
          "expected": {
            "type": "object",
            "required": ["ok", "mode"],
            "properties": {
              "ok": { "type": "boolean" },
              "mode": { "type": "string" },
              "mode_reason": { "type": "string" },
              "refusal_code": { "type": "string" }
            },
            "additionalProperties": false
          },
          "fingerprint": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
