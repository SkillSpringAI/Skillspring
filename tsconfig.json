{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist"
  },
  "include": [
    "runtime/**/*.ts",
    "src/**/*.ts",
    "diagnostics/**/*.ts",
    "schemas/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
